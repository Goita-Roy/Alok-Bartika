PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,https://alok-bartika-frontend.vercel.app,https://alokbartika.vercel.app

# ── AI Assistant (provider abstraction) ────────────────────────────────
# The frontend always calls POST /api/ai/chat. Switch providers via AI_PROVIDER
# without changing any code or the API contract. Supported values:
#   groq (default) · gemini · openrouter · openai
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# OPENAI_API_KEY=     # only needed if AI_PROVIDER=openai
AI_TIMEOUT_MS=30000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/alokbartika?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
CLERK_SECRET_KEY=sk_test_your_secret_key
GOOGLE_CLIENT_ID=your_google_client_id
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Alokbartika <your_email@gmail.com>

# SMS provider (leave empty to disable SMS / use no-op logger).
# Supported values are loaded from backend/src/services/providers/<name>.js
# e.g. twilio, sslwireless, greenweb, bulksmsbd
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_BASE_URL=
